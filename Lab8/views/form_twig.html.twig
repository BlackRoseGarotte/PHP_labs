<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>{{ action == 'edit' ? 'Редактирование' : 'Новая книга' }}</title>
    <link rel="stylesheet" href="../style.css">
</head>
<body>
    <header>
        <h1>{{ action == 'edit' ? 'Редактировать книгу' : 'Новая книга' }}</h1>
        <a href="index.php?engine={{ engine }}">Назад к списку</a>
    </header>

    <main>
        {% if errors is not empty %}
            <ul class="error">
                {% for err in errors %}<li>{{ err }}</li>{% endfor %}
            </ul>
        {% endif %}

        <form method="POST">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            
            <div class="form-group">
                <label>Автор *</label>
                <input type="text" name="author_name" required value="{{ old.author_name ?? '' }}">
            </div>
            
            <div class="form-group">
                <label>Название *</label>
                <input type="text" name="title" required value="{{ old.title ?? '' }}">
            </div>
            
            <div class="form-group">
                <label>ISBN</label>
                <input type="text" name="isbn" value="{{ old.isbn ?? '' }}">
            </div>
            
            <div class="form-group">
                <label>Дата публикации</label>
                <input type="date" name="publication_date" value="{{ old.publication_date ?? '' }}">
            </div>
            
            <div class="form-group">
                <label>Описание *</label>
                <textarea name="description" required minlength="50">{{ old.description ?? '' }}</textarea>
            </div>
            
            <div class="form-group">
                <label>Цена *</label>
                <input type="number" name="price" step="0.01" min="0" required value="{{ old.price ?? '' }}">
            </div>
            
            <div class="form-group checkbox-group">
                <input type="checkbox" name="is_featured" value="1" {{ old.is_featured ? 'checked' : '' }}>
                <label>Рекомендуемое</label>
            </div>

            <button type="submit">{{ action == 'edit' ? 'Сохранить' : 'Создать' }}</button>
        </form>
    </main>
</body>
</html>